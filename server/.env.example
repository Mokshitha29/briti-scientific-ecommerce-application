# ========================================================
# Briti Scientific Chemical E-Commerce - Environment Variables
# ========================================================

# Server Port (Render dynamically assigns PORT)
PORT=5000

# MongoDB Atlas Connection String
# Replace <username>, <password>, and <cluster-url> with your MongoDB Atlas details
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/briti_chemical_store?retryWrites=true&w=majority

# JWT Authentication Secrets
JWT_SECRET=your_super_strong_jwt_production_secret_key_2026
JWT_EXPIRES_IN=1d

# Deployed Frontend URL (Vercel)
CLIENT_URL=https://your-frontend-app.vercel.app

# Environment Mode (production / development)
NODE_ENV=production
